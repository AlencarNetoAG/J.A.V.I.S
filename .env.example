# Copie para .env e preencha LOCALMENTE. Nunca envie sua chave pelo chat.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Client ID público do aplicativo Spotify cadastrado por você (não use senha/client secret).
SPOTIFY_CLIENT_ID=
# Opcional: ID explícito do dispositivo. Sem isso, o Jarvis oferece somente computadores.
SPOTIFY_DEVICE_ID=

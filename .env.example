# Comandos funcionam sem OpenAI e sem IA. Não é necessário chave ou assinatura.
# IA local opcional para conversa/explicação: instale Ollama e baixe este modelo.
# OLLAMA_MODEL=qwen2.5:3b
OLLAMA_MODEL=
# Client ID público do aplicativo Spotify cadastrado por você (não use senha/client secret).
SPOTIFY_CLIENT_ID=
# Opcional: ID explícito do dispositivo. Sem isso, o Jarvis oferece somente computadores.
SPOTIFY_DEVICE_ID=
# Só utilizado ao escolher "OpenAI (opcional)" em Configurações. API com cobrança própria.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini
